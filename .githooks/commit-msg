#!/usr/bin/env bash
# VENDORED from JakobMelchard/.githooks/commit-msg@main — do not edit.
# Refresh: hooks-install  (JakobMelchard/bin), or see JakobMelchard/.githooks/install.
# Repo-specific checks belong in .githooks/commit-msg.local (executable).
# Shared commit-msg. Source: JakobMelchard/.githooks
# Rejects a subject that is not a conventional commit. PRs are squash-merged with
# the PR title as the subject and release-please parses it, so the same regex
# gates PR titles in the org's reusable workflows (JakobMelchard/.github).
# Bypass with --no-verify.
#
# bash 3.2 compatible.
set -eo pipefail

cd "$(git rev-parse --show-toplevel)"
fail() { echo "commit-msg: $*" >&2; exit 1; }

msg=$1
# first line that is neither empty nor a comment (|| true: grep exits 1 on no match under pipefail)
subject=$(grep -v '^#' "$msg" | sed -n '/./{p;q;}' || true)
[ -n "$subject" ] || exit 0    # git aborts an empty message on its own

case "$subject" in
  "Merge "*|"Revert "*|"fixup! "*|"squash! "*|"amend! "*) exit 0 ;;
esac

types='feat|fix|chore|docs|refactor|test|ci|build|perf|style|revert'
if ! printf '%s\n' "$subject" | grep -Eq "^($types)(\([A-Za-z0-9._/-]+\))?!?: .+"; then
  fail "\"$subject\" is not a conventional commit — <type>(<scope>)!: <subject>, type one of $types"
fi
if [ "${#subject}" -gt 100 ]; then
  fail "subject is ${#subject} characters; keep it under 100"
fi

# ── repo-specific extension ──────────────────────────────────────────
if [ -x ".githooks/commit-msg.local" ]; then
  .githooks/commit-msg.local "$msg" || fail "commit-msg.local failed"
fi

exit 0
