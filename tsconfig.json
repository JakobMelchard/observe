{
  // The page shim and its node tests. The service worker has its own config (tsconfig.sw.json):
  // the DOM and WebWorker libs do not mix.
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": true,
    "module": "nodenext",
    "target": "es2022",
    "lib": ["es2023", "dom", "dom.iterable"],
    "types": ["node"],
    "skipLibCheck": true
  },
  "include": ["src/observe/shim/observe.js", "src/observe/shim/types.d.ts", "tests/shim"]
}
