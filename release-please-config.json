{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "packages": {
    ".": {
      "release-type": "python",
      "include-component-in-tag": false,
      "extra-files": [
        { "type": "toml", "path": "sinks/github/pyproject.toml", "jsonpath": "$.project.version" },
        { "type": "toml", "path": "sinks/sentry/pyproject.toml", "jsonpath": "$.project.version" },
        { "type": "toml", "path": "uv.lock", "jsonpath": "$.package[?(@.name.value=='observe')].version" },
        { "type": "generic", "path": "README.md" }
      ]
    }
  },
  "bump-minor-pre-major": true,
  "bump-patch-for-minor-pre-major": true
}
