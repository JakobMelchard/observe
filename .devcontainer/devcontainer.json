{
  "name": "py",
  "image": "mcr.microsoft.com/devcontainers/base:ubuntu-24.04",
  "features": {
    "ghcr.io/jakobmelchard/devcontainer/ws:1": {},
    "ghcr.io/devcontainers/features/python:1": {
      "version": "3.15"
    }
  },
  "postCreateCommand": "curl -LsSf https://astral.sh/uv/install.sh | sh && uv tool install ruff && (test -f pyproject.toml && uv sync --all-extras || true) && prek install",
  "customizations": {
    "codespaces": {
      "repositories": {
        "JakobMelchard/.githooks": {
          "permissions": {
            "contents": "read"
          }
        },
        "JakobMelchard/.agents": {
          "permissions": {
            "contents": "read"
          }
        },
        "JakobMelchard/.config": {
          "permissions": {
            "contents": "read"
          }
        }
      }
    }
  }
}
